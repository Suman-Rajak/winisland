---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';

const { title, description, kicker, heading, intro, updated } = Astro.props;
---

<Base title={title} description={description}>
  <div class="container">
    <header class="level-head">
      <p class="kicker"><Logo size={26} /> {kicker}</p>
      <h1>{heading}</h1>
      {intro && <p class="intro">{intro}</p>}
      {updated && <p class="updated">Last updated: {updated}</p>}
    </header>

    <article class="guide info">
      <slot />
    </article>
  </div>
</Base>

<style>
  .updated {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .info {
    margin-top: 8px;
  }

  .info :global(h3) {
    margin-top: 1.2em;
    font-size: 1.15rem;
  }

  .info :global(section > h3:first-of-type) {
    margin-top: 0.4em;
  }
</style>
