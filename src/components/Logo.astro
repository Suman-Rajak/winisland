  <g stroke="#1b0f4a" stroke-width="1.5" stroke-linejoin="round">
    <path d="M32 35L32 14A21 21 0 0 1 50.19 24.5Z" fill="#ff3fa4"></path>
    <path d="M32 35L50.19 24.5A21 21 0 0 1 50.19 45.5Z" fill="#ffcf3a"></path>
