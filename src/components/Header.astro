---
import Logo from './Logo.astro';
import ToolIcon from './ToolIcon.astro';
import { tools } from '../data/tools.js';

const path = Astro.url.pathname;
---

<header class="hud">
  <div class="container hud-bar">
    <a class="brand" href="/" aria-label="winisland home">
      <Logo size={40} />
      <span class="wordmark">win<span>island</span></span>
    </a>

    <nav id="worlds" class="worlds" aria-label="Games">
      <ul>
        {
          tools.map((tool) => (
            <li>
              <a href={tool.href} aria-current={path.startsWith(tool.href) ? 'page' : undefined}>
                <ToolIcon kind={tool.id} size={26} />
                <span>{tool.short}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="player">
      <button class="level-chip" type="button" data-open-trophies aria-label="Trophy room: your level and badges">
        <span class="lv">
          <span class="lv-label">LV</span>
          <span class="lv-num" data-hud-level>1</span>
        </span>
        <span class="lv-meta">
          <span class="lv-rank" data-hud-rank>Rookie</span>
          <span class="xp-bar"><span data-hud-fill></span></span>
        </span>
        <span class="trophies">
          <ToolIcon kind="trophy" size={20} />
          <span data-hud-badges>0</span>
        </span>
      </button>
      <button id="hud-sound" class="icon-btn" type="button" aria-pressed="true" aria-label="Sound effects">
        <ToolIcon kind="sound" size={22} />
      </button>
    </div>
  </div>
</header>

<script>
  // Scroll the game bar so the current game is in view.
  const bar = document.getElementById('worlds');
  const current = bar?.querySelector('[aria-current="page"]');
  if (bar && current) {
    const offset = current.getBoundingClientRect().left - bar.getBoundingClientRect().left;
    bar.scrollLeft += offset - (bar.clientWidth - current.offsetWidth) / 2;
  }
</script>

<style>
  .hud {
    position: relative;
    z-index: 20;
    background: linear-gradient(180deg, rgb(20 12 54 / 0.95), rgb(20 12 54 / 0.75));
    border-bottom: 1px solid var(--line);
    box-shadow: 0 6px 30px rgb(0 0 0 / 0.35);
  }

  .hud::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), var(--violet), var(--pink), transparent);
    opacity: 0.7;
  }

  .hud-bar {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'brand player'
      'worlds worlds';
    align-items: center;
    gap: 8px 12px;
    padding-block: 10px 8px;
  }

  @media (min-width: 900px) {
    .hud-bar {
      gap: 10px 20px;
      padding-block: 12px 8px;
    }
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .brand svg {
    flex: none;
    filter: drop-shadow(0 0 10px rgb(148 97 255 / 0.6));
    transition: transform 0.3s;
  }

  .brand:hover svg {
    transform: rotate(-12deg) scale(1.05);
  }

  .wordmark {
    font-family: var(--font-display-stack);
    font-size: 1.65rem;
    line-height: 1;
    text-shadow: 0 3px 0 #2a1170;
  }

  .wordmark span {
    color: var(--gold);
  }

  /* Game bar: one row of islands; scrolls sideways on small screens. */
  .worlds {
    grid-area: worlds;
    min-width: 0;
    margin-inline: -16px;
    overflow-x: auto;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 28px), transparent);
  }

  .worlds::-webkit-scrollbar {
    display: none;
  }

  .worlds ul {
    display: flex;
    gap: 4px;
    width: max-content;
    margin: 0 auto;
    padding: 2px 16px 4px;
    list-style: none;
  }

  .worlds a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 14px;
    border: 1px solid transparent;
    color: var(--text);
    font-weight: 800;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .worlds a:hover {
    background: rgb(255 255 255 / 0.07);
  }

  .worlds a[aria-current='page'] {
    background: linear-gradient(180deg, rgb(148 97 255 / 0.4), rgb(148 97 255 / 0.15));
    border-color: rgb(148 97 255 / 0.7);
    box-shadow: 0 0 18px rgb(148 97 255 / 0.4);
  }

  .worlds a :global(svg) {
    flex: none;
    transition: transform 0.2s;
  }

  .worlds a:hover :global(svg) {
    transform: scale(1.15) rotate(-6deg);
  }

  @media (max-width: 520px) {
    .worlds a {
      flex-direction: column;
      gap: 2px;
      min-width: 70px;
      padding: 6px 8px;
      font-size: 0.8rem;
    }
  }

  .player {
    grid-area: player;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
  }

  .level-chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 5px 10px 5px 5px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(10 6 32 / 0.7);
    color: var(--text);
    font: inherit;
    cursor: pointer;
    transition: border-color 0.15s;
  }

  .level-chip:hover {
    border-color: var(--gold);
  }

  .lv {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ffe680, #ffb300 70%);
    color: #3a1c00;
    line-height: 0.9;
    box-shadow: 0 0 14px rgb(255 207 58 / 0.5);
  }

  .lv-label {
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.08em;
  }

  .lv-num {
    font-family: var(--font-display-stack);
    font-size: 1.05rem;
  }

  .lv-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .lv-rank {
    font-size: 0.78rem;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }

  .xp-bar {
    display: block;
    width: 74px;
    height: 7px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }

  .xp-bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--lime), var(--cyan));
    transform-origin: left;
    transform: scaleX(0.02);
    transition: transform 0.6s cubic-bezier(0.2, 1.2, 0.4, 1);
  }

  .trophies {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-weight: 900;
    font-size: 0.9rem;
    color: var(--gold);
  }

  :global(html:not([data-player='ready'])) .level-chip [data-hud-level],
  :global(html:not([data-player='ready'])) .level-chip [data-hud-rank],
  :global(html:not([data-player='ready'])) .level-chip [data-hud-badges] {
    visibility: hidden;
  }

  .level-chip :global(.xp-pop) {
    position: absolute;
    right: 8px;
    top: -6px;
    font-weight: 900;
    font-size: 0.9rem;
    color: var(--lime);
    text-shadow: 0 2px 0 #0b3d12;
    pointer-events: none;
    animation: xp-rise 1.2s ease-out forwards;
  }

  @keyframes xp-rise {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    to {
      transform: translateY(-26px);
      opacity: 0;
    }
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(10 6 32 / 0.7);
    color: var(--text);
    cursor: pointer;
  }

  .icon-btn:hover {
    border-color: var(--cyan);
  }

  .icon-btn[aria-pressed='true'] :global(.mute),
  .icon-btn[aria-pressed='false'] :global(.wave) {
    display: none;
  }

  .icon-btn[aria-pressed='false'] {
    color: var(--muted);
  }

  /* Phones: keep the level and XP bar; rank and badge count live in the trophy room. */
  @media (max-width: 520px) {
    .brand :global(svg) {
      width: 34px;
      height: 34px;
    }

    .wordmark {
      font-size: 1.4rem;
    }

    .lv-rank,
    .trophies {
      display: none;
    }

    .xp-bar {
      width: 56px;
    }

    .icon-btn {
      width: 42px;
      height: 42px;
    }
  }
</style>
