---
import { badges } from '../data/badges.js';
---

<dialog id="trophy-room" class="trophy-room" aria-labelledby="trophy-title">
  <form method="dialog">
    <button class="reward-close" aria-label="Close trophy room">✕</button>
  </form>
  <p class="room-kicker">Player profile</p>
  <h2 id="trophy-title">Level <span data-hud-level>1</span> · <span data-hud-rank>Rookie</span></h2>
  <div class="room-xp"><span data-hud-fill></span></div>
  <p class="room-xp-text">
    <strong data-hud-xp>0</strong> XP · <span data-hud-next>50</span> XP to the next level
  </p>

  <h3>Badges <span class="chip"><span data-hud-badges>0</span> / {badges.length}</span></h3>
  <ul class="badge-grid">
    {
      badges.map((b) => (
        <li class="badge" data-badge={b.id}>
          <span class="b-icon" aria-hidden="true">
            {b.icon}
          </span>
          <span class="b-name">{b.name}</span>
          <span class="b-desc">{b.desc}</span>
          <span class="b-state sr-only">Locked</span>
        </li>
      ))
    }
  </ul>

  <h3>How to earn XP</h3>
  <ul class="xp-list">
    <li><span>Spin the wheel</span><b>+10</b></li>
    <li><span>Call a tambola number</span><b>+2</b></li>
    <li><span>Finish a full tambola game</span><b>+50</b></li>
    <li><span>Create a tambola room</span><b>+20</b></li>
    <li><span>Print tambola tickets</span><b>+10</b></li>
    <li><span>Pick a giveaway winner</span><b>+15</b></li>
    <li><span>Split players into teams</span><b>+15</b></li>
    <li><span>Run a Secret Santa draw</span><b>+20</b></li>
    <li><span>Flip a coin or roll dice</span><b>+5</b></li>
    <li><span>Discover a new island</span><b>+20</b></li>
    <li><span>Play on a new day</span><b>+25</b></li>
    <li><span>Unlock a badge</span><b>+30</b></li>
  </ul>
  <p class="room-note">Your progress is saved in this browser only. No account needed.</p>
</dialog>

<style>
  .trophy-room {
    width: min(94vw, 560px);
    max-height: 88vh;
    padding: 28px 22px 22px;
    border: 2px solid transparent;
    border-radius: 26px;
    color: var(--text);
    background:
      linear-gradient(180deg, #2a1a73, #150d3f) padding-box,
      linear-gradient(135deg, var(--gold), var(--violet), var(--cyan)) border-box;
    box-shadow: 0 0 80px rgb(148 97 255 / 0.45);
  }

  .trophy-room::backdrop {
    background: rgb(6 3 20 / 0.75);
  }

  .trophy-room[open] {
    animation: room-in 0.35s cubic-bezier(0.2, 1.4, 0.4, 1);
  }

  @keyframes room-in {
    from {
      transform: translateY(20px) scale(0.92);
      opacity: 0;
    }
  }

  .room-kicker {
    margin: 0;
    color: var(--cyan);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
  }

  h2 {
    font-size: 1.9rem;
    margin: 4px 0 12px;
  }

  h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 12px;
  }

  .room-xp {
    height: 14px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }

  .room-xp span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--lime), var(--cyan));
    transform-origin: left;
    transform: scaleX(0.02);
    border-radius: inherit;
  }

  .room-xp-text {
    margin: 8px 0 0;
    color: var(--muted);
  }

  .room-xp-text strong {
    color: var(--text);
  }

  .badge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 12px 8px;
    border-radius: 16px;
    border: 1px dashed var(--line-strong);
    background: rgb(0 0 0 / 0.2);
    text-align: center;
  }

  .b-icon {
    font-size: 2rem;
    line-height: 1.2;
    filter: grayscale(1) brightness(0.55);
  }

  .b-name {
    font-weight: 900;
    font-size: 0.9rem;
    line-height: 1.2;
  }

  .b-desc {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .badge.earned {
    border: 1px solid var(--gold);
    background: radial-gradient(circle at 50% 0%, rgb(255 207 58 / 0.25), rgb(0 0 0 / 0.15) 70%);
    box-shadow: 0 0 18px rgb(255 207 58 / 0.25);
  }

  .badge.earned .b-icon {
    filter: none;
  }

  .xp-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .xp-list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.05);
  }

  .xp-list b {
    color: var(--lime);
  }

  .room-note {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
</style>
