<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.MediaCompactView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Artwork on the left, level bars on the right. -->
    <Grid Padding="6,0,14,0">
        <Grid x:Name="ArtHost" Width="24" Height="24" HorizontalAlignment="Left">
            <Border CornerRadius="7" Background="#26FFFFFF">
                <FontIcon Glyph="&#xE8D6;" FontSize="11" Foreground="#99FFFFFF" />
            </Border>
            <Border CornerRadius="7">
                <Border.Background>
                    <ImageBrush x:Name="Art" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>
        <StackPanel x:Name="Bars" Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Style="{StaticResource LevelBarStyle}" />
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Style="{StaticResource LevelBarStyle}" />
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Style="{StaticResource LevelBarStyle}" />
            <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Style="{StaticResource LevelBarStyle}" />
        </StackPanel>
    </Grid>
</UserControl>
