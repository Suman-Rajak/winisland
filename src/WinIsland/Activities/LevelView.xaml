<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.LevelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Icon, level bar, percentage: the volume / brightness indicator. -->
    <Grid Padding="14,0" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="26" />
        </Grid.ColumnDefinitions>

        <FontIcon x:Name="Icon" FontSize="15" Foreground="White" VerticalAlignment="Center" />

        <Grid x:Name="Track" Grid.Column="1" Height="6" VerticalAlignment="Center" SizeChanged="OnTrackSizeChanged">
            <Border CornerRadius="3" Background="#33FFFFFF" />
            <Border x:Name="Fill" CornerRadius="3" HorizontalAlignment="Left" Width="0"
                    Background="{StaticResource IslandAccentBrush}" />
        </Grid>

        <TextBlock x:Name="ValueText" Grid.Column="2" FontSize="12" Foreground="#CCFFFFFF"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
