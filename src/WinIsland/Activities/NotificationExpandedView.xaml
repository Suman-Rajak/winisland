<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.NotificationExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
        </Style>
    </UserControl.Resources>

    <!-- The whole message, with Open and Clear. -->
    <Grid Padding="18,16,18,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="40" Height="40">
                <Border CornerRadius="10" Background="#26FFFFFF">
                    <FontIcon Glyph="&#xEA8F;" FontSize="17" Foreground="#B3FFFFFF" />
                </Border>
                <Border CornerRadius="10">
                    <Border.Background>
                        <ImageBrush x:Name="Icon" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="AppText" FontSize="11" Foreground="#80FFFFFF" />
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>

        <TextBlock x:Name="BodyText" Grid.Row="1" FontSize="13" Foreground="#D9FFFFFF" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" MaxLines="4" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Clear" Style="{StaticResource ActionButtonStyle}" Click="OnClearClick"
                    ToolTipService.ToolTip="Remove it from Windows' notification centre" />
            <Button Content="Open" Style="{StaticResource ActionButtonStyle}" Click="OnOpenClick" />
        </StackPanel>
    </Grid>
</UserControl>
