<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.TimersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland.Activities">

    <!-- Everything set, soonest first: [icon] Call Mom / Today at 5:00 PM ........ 1:42:10 [×] -->
    <Grid Padding="10,0,10,10">
        <ListView x:Name="List" ItemsSource="{x:Bind Rows}" SelectionMode="None" IsTabStop="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Height" Value="40" />
                    <Setter Property="Padding" Value="8,0,4,0" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="IsTabStop" Value="False" />
                    <Setter Property="UseSystemFocusVisuals" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TimerRow">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="#FFFF9F0A" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="13" Foreground="White"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock Text="{x:Bind When}" FontSize="11" Foreground="#80FFFFFF"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{x:Bind Remaining, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#CCFFFFFF" VerticalAlignment="Center" />

                        <Button Grid.Column="3" Style="{StaticResource IslandButtonStyle}" Width="26" Height="26" CornerRadius="13"
                                Click="OnCancelClick" Tag="{x:Bind}" ToolTipService.ToolTip="Cancel">
                            <FontIcon Glyph="&#xE711;" FontSize="10" Foreground="#99FFFFFF" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
