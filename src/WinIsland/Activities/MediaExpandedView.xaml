<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.MediaExpandedView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Artwork, title, progress, controls. -->
    <Grid Padding="20,18,20,10" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Border CornerRadius="14" Background="#26FFFFFF">
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="#99FFFFFF" />
                </Border>
                <Border CornerRadius="14">
                    <Border.Background>
                        <ImageBrush x:Name="Art" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="White"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="ArtistText" FontSize="13" Foreground="#B3FFFFFF"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock x:Name="SourceText" FontSize="11" Foreground="#73FFFFFF" MaxLines="1" />
            </StackPanel>

            <StackPanel x:Name="Bars" Grid.Column="2" Orientation="Horizontal" Spacing="2.5"
                        VerticalAlignment="Top" Margin="0,8,0,0">
                <Rectangle Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Style="{StaticResource LevelBarStyle}" />
                <Rectangle Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Style="{StaticResource LevelBarStyle}" />
                <Rectangle Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Style="{StaticResource LevelBarStyle}" />
                <Rectangle Width="3.5" Height="18" RadiusX="1.75" RadiusY="1.75" Style="{StaticResource LevelBarStyle}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ProgressRow" Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="#99FFFFFF" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Minimum="0" Maximum="1"
                         Foreground="{StaticResource IslandAccentBrush}" Background="#33FFFFFF" VerticalAlignment="Center" />
            <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="11" Foreground="#99FFFFFF"
                       VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource IslandButtonStyle}" Click="OnPreviousClick"
                    ToolTipService.ToolTip="Previous">
                <FontIcon Glyph="&#xE892;" FontSize="18" />
            </Button>
            <Button Style="{StaticResource IslandButtonStyle}" Click="OnPlayPauseClick"
                    ToolTipService.ToolTip="Play / pause">
                <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE769;" FontSize="24" />
            </Button>
            <Button Style="{StaticResource IslandButtonStyle}" Click="OnNextClick"
                    ToolTipService.ToolTip="Next">
                <FontIcon Glyph="&#xE893;" FontSize="18" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
