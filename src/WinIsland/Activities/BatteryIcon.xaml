<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.BatteryIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="27" Height="13">

    <!-- A small battery: outline, terminal nub, and a fill sized to the charge. -->
    <Grid>
        <Border Width="24" HorizontalAlignment="Left" CornerRadius="3.5" BorderThickness="1.2" BorderBrush="#99FFFFFF" />
        <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" Fill="#99FFFFFF" HorizontalAlignment="Right" />
        <Border x:Name="Fill" Margin="2.2" HorizontalAlignment="Left" CornerRadius="1.8" />
    </Grid>
</UserControl>
