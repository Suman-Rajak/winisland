<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.BatteryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- [bolt] Charging ........ 64% [battery] -->
    <Grid Padding="14,0,14,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <FontIcon x:Name="Glyph" FontSize="14" VerticalAlignment="Center" />

        <TextBlock x:Name="Label" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="White"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <TextBlock x:Name="PercentText" Grid.Column="2" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />

        <!-- A small battery: outline, terminal nub, and a fill sized to the charge. -->
        <Grid Grid.Column="3" Width="27" Height="13" VerticalAlignment="Center">
            <Border x:Name="Outline" Width="24" HorizontalAlignment="Left" CornerRadius="3.5"
                    BorderThickness="1.2" BorderBrush="#99FFFFFF" />
            <Rectangle Width="2" Height="5" RadiusX="1" RadiusY="1" Fill="#99FFFFFF" HorizontalAlignment="Right" />
            <Border x:Name="Fill" Margin="2.2" HorizontalAlignment="Left" CornerRadius="1.8" />
        </Grid>
    </Grid>
</UserControl>
