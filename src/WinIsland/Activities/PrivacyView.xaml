<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WinIsland.Activities.PrivacyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- [mic] Discord ........ Microphone -->
    <Grid Padding="14,0,16,0" ColumnSpacing="9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <FontIcon x:Name="MicIcon" Glyph="&#xE720;" FontSize="14" />
            <FontIcon x:Name="CameraIcon" Glyph="&#xE714;" FontSize="14" />
        </StackPanel>

        <TextBlock x:Name="AppText" Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="White"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="1" />

        <TextBlock x:Name="WhatText" Grid.Column="2" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
    </Grid>
</UserControl>
