<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinIsland.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland"
    Title="Glyde Settings">

    <Grid>
        <Grid.Resources>
            <!-- One settings row: title and description on the left, the control on the right. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="64" />
            </Style>
            <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="2,20,0,6" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar (the window draws its own, over the Mica background) -->
        <StackPanel x:Name="AppTitleBar" Orientation="Horizontal" Spacing="12" Padding="16,0" VerticalAlignment="Center">
            <Image x:Name="TitleBarIcon" Width="16" Height="16" />
            <TextBlock Text="Glyde Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <!-- As the window opens the cards rise in one after another; when one grows (a key box
                 appearing), the ones below glide down to make room. Hover and the rest: see AddMotion. -->
            <StackPanel x:Name="Cards" Padding="24,0,24,24" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="28" />
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <!-- Glyde itself: its face (its eyes follow your pointer round the window; point at it and it
                     smiles), its name and version. -->
                <Grid x:Name="Hero" ColumnSpacing="16" Margin="2,6,0,6" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <local:GlydeFace x:Name="HeroFace" Width="60" Height="60" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Glyde" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="HeroCaption" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- General -->
                <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" Margin="2,12,0,6" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="StartupDescription" Text="Open Glyde when you sign in." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnStartupToggled" />
                    </Grid>
                </Border>

                <!-- Position -->
                <TextBlock Text="Position" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Display" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Which screen the island sits on." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="DisplayCombo" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="OnDisplayChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Distance from top" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="0 makes it hug the top edge of the screen." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="DistanceSlider" Width="160" Minimum="0" Maximum="40" StepFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="OnDistanceChanged" />
                            <TextBlock x:Name="DistanceLabel" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Mac-style notch" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="The island becomes a black notch hanging from the top edge, always there, in a frosted bar as tall as it is. Maximized and snapped windows start below the bar, like on a Mac."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotchToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnNotchToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Menu bar" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="In the bar beside the notch, like a Mac's: Glyde's menu, the app you're in and Go on the left; your pinned apps, Glyde, Wi-Fi, sound, battery and the time on the right."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MenuBarToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnMenuBarToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bar colour" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="The bar beside the notch takes the colour of the page you're on, or matches the taskbar."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="BarColourCombo" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="OnBarColourChanged">
                            <ComboBoxItem Content="The page you're on" Tag="Page" />
                            <ComboBoxItem Content="Same as the taskbar" Tag="Taskbar" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hide when idle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Fade the island out when nothing is playing. Point at the top of the screen to bring it back."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="HideIdleToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnHideIdleToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Step aside for apps" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="When an app is under the island (a browser's tabs, say), clicks go through to it and the island fades as you point past it. Rest the pointer on the island for a moment to open it."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StepAsideToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnStepAsideToggled" />
                    </Grid>
                </Border>

                <!-- Look and feel -->
                <TextBlock Text="Look and feel" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Animation speed" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="How quickly the island opens and closes." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="SpeedCombo" Grid.Column="1" MinWidth="200" VerticalAlignment="Center"
                                  SelectionChanged="OnSpeedChanged">
                            <ComboBoxItem Content="Relaxed" Tag="Relaxed" />
                            <ComboBoxItem Content="Normal" Tag="Normal" />
                            <ComboBoxItem Content="Snappy" Tag="Snappy" />
                        </ComboBox>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Glass transparency" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="A hint of what's behind the island showing through. 0 is solid." Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Slider x:Name="TransparencySlider" Width="160" Minimum="0" Maximum="10" StepFrequency="1"
                                    VerticalAlignment="Center" ValueChanged="OnTransparencyChanged" />
                            <TextBlock x:Name="TransparencyLabel" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Match the music's colours" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Tint the glass with colours from the album art while music plays."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="MusicColorsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnMusicColorsToggled" />
                    </Grid>
                </Border>

                <!-- What the island shows -->
                <TextBlock Text="Show on the island" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Volume and brightness" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Briefly show the level when you change it, or when you switch speakers."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="LevelsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnLevelsToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Battery and charging" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Show when you plug in, when the battery is full, and when it's running low."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BatteryToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnBatteryToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Bluetooth devices" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Show headphones, speakers and other devices connecting and disconnecting, with their battery when they report it."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="BluetoothToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnBluetoothToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Microphone and camera in use" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="A dot beside the island while an app uses your microphone (orange) or camera (green). Point at it to see which app."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="PrivacyToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnPrivacyToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Clipboard history" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="A tab with the last 20 things you copied; click one to copy it again. Kept in memory only, so it's gone when Glyde quits. Things password managers mark as private are never kept."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClipboardToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnClipboardToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="File shelf" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="A tab where you can park files: drag them onto the island, then drag them out wherever you need them. Your files stay where they are."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShelfToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnShelfToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Notifications" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="NotificationsDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnNotificationsToggled" />
                    </Grid>
                </Border>

                <!-- Voice assistant (named in code: Assistant.Name) -->
                <TextBlock x:Name="AssistantHeader" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="AssistantTitle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="AssistantDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AssistantToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAssistantToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Talk shortcut" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="ShortcutDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="ShortcutCombo" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                                  SelectionChanged="OnShortcutChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Type shortcut" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="TypeShortcutDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="TypeShortcutCombo" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                                  SelectionChanged="OnTypeShortcutChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="I speak" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="LanguagesDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguagesCombo" Grid.Column="1" MinWidth="170" VerticalAlignment="Center"
                                  SelectionChanged="OnLanguagesChanged" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="WakeWordTitle" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="WakeWordDescription" Style="{StaticResource CardDescriptionStyle}" />
                            <TextBlock x:Name="WakeWordStatus" Style="{StaticResource CardDescriptionStyle}" Margin="0,4,0,0"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        </StackPanel>
                        <ToggleSwitch x:Name="WakeWordToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnWakeWordToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Follow-up questions" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock x:Name="FollowUpsDescription" Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FollowUpsToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnFollowUpsToggled" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BrainTitle" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="BrainDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="BrainToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnBrainToggled" />
                        </Grid>
                        <!-- Which model: Claude Haiku (fastest, paid) or Gemini (free), each with its own key. -->
                        <Grid x:Name="BrainChoiceRow" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Model" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="BrainChoiceDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="BrainCombo" Grid.Column="1" MinWidth="210" VerticalAlignment="Center" SelectionChanged="OnBrainChanged">
                                <ComboBoxItem Content="Claude Haiku (fastest)" Tag="Claude" />
                                <ComboBoxItem Content="Gemini Flash (free)" Tag="Gemini" />
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="ClaudeKeyRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ClaudeKeyBox" PlaceholderText="Anthropic API key" />
                            <Button Grid.Column="1" Content="Save" Click="OnSaveClaudeKeyClick" />
                            <Button Grid.Column="2" x:Name="TestClaudeButton" Content="Test" Click="OnTestBrainClick" />
                        </Grid>
                        <HyperlinkButton x:Name="ClaudeLink" Content="Get a key at console.anthropic.com" NavigateUri="https://console.anthropic.com/settings/keys" Padding="0" />
                        <Grid x:Name="BrainKeyRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="GeminiKeyBox" PlaceholderText="Gemini API key" />
                            <Button Grid.Column="1" Content="Save" Click="OnSaveKeyClick" />
                            <Button Grid.Column="2" x:Name="TestBrainButton" Content="Test" Click="OnTestBrainClick" />
                        </Grid>
                        <HyperlinkButton x:Name="GeminiLink" Content="Get a free key from Google AI Studio" NavigateUri="https://aistudio.google.com/apikey" Padding="0" />
                        <!-- A spinner beside it while Test is asking. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="BrainTesting" Width="14" Height="14" MinWidth="0" MinHeight="0" Margin="0,0,8,0"
                                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="BrainStatus" Grid.Column="1" Style="{StaticResource CardDescriptionStyle}" />
                        </Grid>
                        <Grid x:Name="CloudSpeechRow" ColumnSpacing="16" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Understand speech with Gemini" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="CloudSpeechDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CloudSpeechToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnCloudSpeechToggled" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Hear requests with Deepgram" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="DeepgramDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="DeepgramToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnDeepgramToggled" />
                        </Grid>
                        <Grid x:Name="DeepgramKeyRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="DeepgramKeyBox" PlaceholderText="Deepgram API key" />
                            <Button Grid.Column="1" Content="Save" Click="OnSaveDeepgramKeyClick" />
                            <Button Grid.Column="2" x:Name="TestDeepgramButton" Content="Test" Click="OnTestDeepgramClick" />
                        </Grid>
                        <HyperlinkButton x:Name="DeepgramLink" Content="Get a free key from Deepgram" NavigateUri="https://console.deepgram.com/signup" Padding="0" />
                        <Grid x:Name="DeepgramStatusRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="DeepgramTesting" Width="14" Height="14" MinWidth="0" MinHeight="0" Margin="0,0,8,0"
                                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="DeepgramStatus" Grid.Column="1" Style="{StaticResource CardDescriptionStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- The voice it answers in: Azure's natural voices, in your accent (or a chosen one). -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Natural voice (Microsoft Azure)" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="VoiceDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="VoiceToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnVoiceToggled" />
                        </Grid>
                        <Grid x:Name="VoiceKeyRow" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="AzureKeyBox" PlaceholderText="Azure Speech key" />
                            <TextBox x:Name="AzureRegionBox" Grid.Column="1" PlaceholderText="Region" ToolTipService.ToolTip="Your Speech resource's region, like centralindia or eastus" />
                            <Button Grid.Column="2" Content="Save" Click="OnSaveAzureClick" />
                            <Button Grid.Column="3" x:Name="TestVoiceButton" Content="Test" Click="OnTestVoiceClick" />
                        </Grid>
                        <HyperlinkButton x:Name="AzureLink" Content="Get a free key: create a Speech resource in the Azure portal"
                                         NavigateUri="https://portal.azure.com/#create/Microsoft.CognitiveServicesSpeechServices" Padding="0" />
                        <Grid x:Name="VoiceStatusRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="VoiceTesting" Width="14" Height="14" MinWidth="0" MinHeight="0" Margin="0,0,8,0"
                                          IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
                            <TextBlock x:Name="VoiceStatus" Grid.Column="1" Style="{StaticResource CardDescriptionStyle}" />
                        </Grid>
                        <Grid x:Name="AccentRow" ColumnSpacing="12" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Accent and voice" Style="{StaticResource CardTitleStyle}" />
                                <TextBlock x:Name="AccentDescription" Style="{StaticResource CardDescriptionStyle}" />
                            </StackPanel>
                            <ComboBox x:Name="AccentCombo" Grid.Column="1" MinWidth="150" VerticalAlignment="Center" SelectionChanged="OnAccentChanged">
                                <ComboBoxItem Content="Match mine" Tag="MatchMine" />
                                <ComboBoxItem Content="Indian English" Tag="Indian" />
                                <ComboBoxItem Content="American English" Tag="American" />
                                <ComboBoxItem Content="British English" Tag="British" />
                            </ComboBox>
                            <ComboBox x:Name="VoiceGenderCombo" Grid.Column="2" MinWidth="100" VerticalAlignment="Center" SelectionChanged="OnVoiceGenderChanged">
                                <ComboBoxItem Content="Female" Tag="Female" />
                                <ComboBoxItem Content="Male" Tag="Male" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Music -->
                <TextBlock Text="Music" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Find missing album art online" Style="{StaticResource CardTitleStyle}" />
                            <TextBlock Text="Some apps, like Amazon Music, don't share their artwork. Glyde can look it up in Apple's iTunes catalogue and MusicBrainz, which sends the song title and artist to them."
                                       Style="{StaticResource CardDescriptionStyle}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ArtworkToggle" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnArtworkToggled" />
                    </Grid>
                </Border>

                <!-- About -->
                <Grid Margin="2,24,0,0">
                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Content="Reset to defaults" HorizontalAlignment="Right" Click="OnResetClick" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
