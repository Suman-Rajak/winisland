<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>WinIsland</RootNamespace>
    <AssemblyName>Glyde</AssemblyName> <!-- the product's name (Product.cs); the code namespace keeps the working name -->
    <Version>0.2.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <Configurations>Debug;Release;Packaged</Configurations>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- reading microphone buffers -->
  </PropertyGroup>

  <!--
    Two ways to build:
    - Debug / Release: a plain exe. Everything works except notifications.
    - Packaged (-c Packaged): an MSIX layout with package identity, which Windows requires before it shares
      notifications. Unsigned, so it's registered in place with Developer Mode on; see build-package.ps1.
      Its own configuration, so its output (bin\x64\Packaged) never mixes with the plain build's.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Packaged'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Packaged'">
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.4.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- Siro's speech-to-text: Whisper on the GPU through Vulkan, with a CPU fallback. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <!-- Whisper's packages bring native libraries for every OS and processor; keep only the Windows ones for this build's. -->
  <Target Name="KeepOnlyThisPlatformsWhisperLibraries" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes')) and !$([System.String]::Copy('%(None.TargetPath)').Contains('/win-$(Platform.ToLowerInvariant())/'))" />
    </ItemGroup>
  </Target>

</Project>
