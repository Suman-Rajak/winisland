<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinIsland.IslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinIsland">

    <!--
        Stage fills the (transparent) window. Its composition visual is clipped to an animated
        rounded rectangle in code, so the background *is* the pill, and every layer below is
        revealed by the pill as it grows.

        The glass is built from layers, back to front: Backdrop holds the tint (matched to the
        artwork while music plays) and a soft colour wash made from the artwork (GlowLayer); its
        opacity is the "glass transparency" setting. Then a top highlight and bright rim drawn in
        code (SheenHost), then the activities' views (ContentHost).

        The island is always dark, whatever the Windows theme; the settings window follows Windows.
    -->
    <Grid x:Name="Stage" RequestedTheme="Dark">
        <Grid x:Name="Backdrop" Background="#FF1C1C1F" Opacity="0.92" IsHitTestVisible="False">
            <Grid.BackgroundTransition>
                <BrushTransition Duration="0:0:0.5" />
            </Grid.BackgroundTransition>
            <Rectangle x:Name="GlowLayer" Opacity="0">
                <Rectangle.Fill>
                    <ImageBrush x:Name="GlowBrush" Stretch="Fill" />
                </Rectangle.Fill>
                <Rectangle.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.4" />
                </Rectangle.OpacityTransition>
            </Rectangle>
        </Grid>

        <Canvas x:Name="SheenHost" IsHitTestVisible="False" />

        <!-- Every activity's compact and expanded views, stacked; only the one being shown is visible. -->
        <Grid x:Name="ContentHost" />
    </Grid>
</Window>
