<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="WinIsland.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinIsland">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by the island's activity views. The island recolours this brush from the album art. -->
            <SolidColorBrush x:Key="IslandAccentBrush" Color="White" />

            <Style x:Key="IslandButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="White" />
                <!-- The island never takes keyboard focus (its window is no-activate). -->
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <!-- Grows a touch under the pointer, sinks when pressed (see Press). -->
                <Setter Property="local:Press.Effect" Value="True" />
            </Style>

            <Style x:Key="LevelBarStyle" TargetType="Rectangle">
                <Setter Property="Fill" Value="{StaticResource IslandAccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
