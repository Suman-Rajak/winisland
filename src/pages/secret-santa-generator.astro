---
import ToolPage from '../layouts/ToolPage.astro';
import AdSlot from '../components/AdSlot.astro';
import Island from '../components/Island.astro';
---

<ToolPage
  title="Secret Santa Generator – Free Name Draw with Private Links | winisland"
  description="Free Secret Santa generator: draw names, add exclusions for couples, set a budget and send everyone a private reveal link on WhatsApp. No sign-up, no emails."
  island="santa"
  heading="Secret Santa Generator"
  intro="Draw names in seconds and send each person a private link that reveals who they're buying for. Nobody needs to sign up, not even you."
>
  <section class="arena santa-arena" aria-label="Secret Santa generator">
    <div class="santa-options panel">
      <div class="entries-head">
        <h2 class="panel-title"><label for="people">Who's playing?</label></h2>
        <span id="people-count" class="chip">0 people</span>
      </div>
      <textarea id="people" rows="8" spellcheck="false" placeholder={'Priya\nRahul\nAnita\nKabir\nSara'}></textarea>
      <p class="hint">One name per line, at least 3 people.</p>

      <div class="field">
        <label for="exclude">Who shouldn't draw each other? <span class="optional">(optional)</span></label>
        <textarea id="exclude" rows="3" spellcheck="false" placeholder={'Priya, Rahul\nAnita, Kabir'}></textarea>
        <p class="hint">One group per line, for couples or families. People on the same line never draw each other.</p>
      </div>

      <div class="two">
        <div class="field">
          <label for="budget">Budget</label>
          <input id="budget" type="text" maxlength="20" placeholder="₹500" />
        </div>
        <div class="field">
          <label for="date">Exchange date</label>
          <input id="date" type="date" />
        </div>
      </div>
      <div class="field">
        <label for="event">Event name <span class="optional">(optional)</span></label>
        <input id="event" type="text" maxlength="40" placeholder="Office Christmas Party" />
      </div>
      <div class="field">
        <label for="note">Message for everyone <span class="optional">(optional)</span></label>
        <input id="note" type="text" maxlength="120" placeholder="Wrap it in newspaper!" />
      </div>

      <p id="santa-error" class="error" role="alert"></p>
      <button id="draw" class="btn btn-play btn-lg" type="button">Draw names</button>
    </div>

    <div class="santa-stage">
      <div id="santa-idle" class="santa-idle">
        <Island kind="santa" uid="stage-santa" class="idle-art" />
        <p class="idle-title">Ho ho ho!</p>
        <p class="hint">Add everyone's names and press Draw names. You won't see who got whom.</p>
      </div>

      <div id="santa-done" class="santa-done" hidden>
        <p class="reward-kicker">🎅 Names drawn!</p>
        <p class="done-sub">Send each person their own secret link. It reveals who they're buying for.</p>
        <ul id="send-list" class="send-list"></ul>
        <div class="btn-row">
          <button id="print-slips" class="btn"><span aria-hidden="true">🖨️</span> Print slips</button>
          <button id="show-pairs" class="btn" aria-expanded="false"><span aria-hidden="true">👀</span> Show all pairs</button>
          <button id="redraw" class="btn"><span aria-hidden="true">🔁</span> Draw again</button>
        </div>
        <ol id="pairs" class="pairs" hidden></ol>
        <p id="send-status" class="hint" aria-live="polite"></p>
        <p class="watermark">Picked on <b>winisland.in</b></p>
      </div>
    </div>
  </section>

  <Fragment slot="guide">
    <section class="panel">
      <h2>How to run a Secret Santa</h2>
      <ol>
        <li>Type everyone's name, one per line.</li>
        <li>Add couples or family members who shouldn't draw each other, if any.</li>
        <li>Set a budget, an exchange date and a message, then press <strong>Draw names</strong>.</li>
        <li>
          Send each person their link with the <strong>WhatsApp</strong> button, or copy it into a message or email. When
          they open it, they tap a gift box to see who they're buying for.
        </li>
      </ol>
      <p>
        Hosting in person? Press <strong>Print slips</strong>, cut them out, fold each one and hand it to the person whose
        name is on the outside.
      </p>
    </section>

    <AdSlot name="inGuide" />

    <section class="panel">
      <h2>Can the organiser play too?</h2>
      <p>
        Yes. The names are drawn without showing you any pairs, and each link only reveals one person's match. Just
        don't open other people's links or press <strong>Show all pairs</strong>. The draw is saved on your device, so you
        can resend a link if someone loses theirs.
      </p>
    </section>

    <section class="panel">
      <h2>Secret Santa gift ideas</h2>
      <ul>
        <li><strong>Under ₹500 / $10:</strong> a fun mug, scented candle, quirky socks, a plant or a snack hamper.</li>
        <li><strong>Under ₹1000 / $25:</strong> a book, a desk organiser, a board game or a cosy blanket.</li>
        <li><strong>Experiences:</strong> a coffee voucher, movie tickets or a class they'd enjoy.</li>
        <li><strong>Personal touches:</strong> a framed photo, a handwritten card, or something linked to their hobby.</li>
      </ul>
    </section>

    <section class="panel faq">
      <h2>Frequently asked questions</h2>
      <details>
        <summary>Is the draw fair?</summary>
        <p>
          Yes. Names are drawn with your browser's cryptographic random number generator. Nobody draws themselves, and
          your exclusion rules are always followed.
        </p>
      </details>
      <details>
        <summary>Do people need an app or an email address?</summary>
        <p>No. Each person just opens a link in any browser. There's no sign-up for anyone.</p>
      </details>
      <details>
        <summary>Is the information private?</summary>
        <p>
          Yes. Everything happens in your browser. Each match travels inside its own link, in the part after the # that
          is never sent to any server, including ours.
        </p>
      </details>
      <details>
        <summary>What if someone drops out?</summary>
        <p>Remove their name and press <strong>Draw again</strong>, then send everyone their new link.</p>
      </details>
    </section>
  </Fragment>
</ToolPage>

<style>
  .santa-arena {
    display: grid;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .santa-arena {
      grid-template-columns: minmax(300px, 380px) minmax(0, 1fr);
      gap: 30px;
      align-items: start;
    }
  }

  .santa-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
  }

  .entries-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .santa-options .hint,
  .santa-options .error {
    margin: 0;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .optional {
    font-weight: 600;
    color: var(--muted);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .santa-stage {
    min-width: 0;
    border-radius: 22px;
    padding: 22px 18px;
    background: radial-gradient(ellipse at 50% 0%, #4a1238 0%, #170d42 60%, #0c0727 100%);
    border: 1px solid var(--line);
  }

  .santa-idle {
    text-align: center;
  }

  .santa-idle[hidden],
  .santa-done[hidden] {
    display: none;
  }

  .santa-idle :global(.idle-art) {
    width: min(230px, 70%);
    margin: 0 auto;
    animation: bob 4s ease-in-out infinite;
  }

  @keyframes bob {
    50% {
      transform: translateY(-10px);
    }
  }

  .idle-title {
    margin: 0;
    font-family: var(--font-display-stack);
    font-size: 1.8rem;
  }

  .santa-done {
    display: grid;
    gap: 14px;
  }

  .done-sub {
    margin: -6px 0 0;
    color: var(--muted);
  }

  .send-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }

  .send-list :global(li) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgb(0 0 0 / 0.25);
  }

  .send-list :global(.who) {
    font-weight: 900;
    overflow-wrap: anywhere;
  }

  .send-list :global(.who small) {
    display: block;
    font-weight: 600;
    color: var(--muted);
  }

  .send-list :global(.btn) {
    min-height: 38px;
    padding: 0.4em 0.9em;
    font-size: 0.85rem;
  }

  .send-list :global(li.sent) {
    border-color: var(--lime);
  }

  .pairs {
    margin: 0;
    padding: 12px 12px 12px 34px;
    border-radius: 14px;
    border: 1px dashed var(--pink);
    background: rgb(255 63 164 / 0.08);
  }

  .pairs[hidden] {
    display: none;
  }

  .pairs :global(li) {
    margin: 4px 0;
    font-weight: 800;
  }

  .santa-done .hint:empty {
    display: none;
  }
</style>

<script>
  import { load, save } from '../scripts/storage.js';
  import { sfx } from '../scripts/sfx.js';
  import { confetti } from '../scripts/confetti.js';
  import { award } from '../scripts/player.js';
  import { drawPairs, revealLink } from '../scripts/santa.js';
  import { printPages } from '../scripts/ticket-view.js';

  const STORE_KEY = 'winisland:santa';
  const MAX_PEOPLE = 150;

  const $ = (id) => document.getElementById(id);
  const fields = {
    people: $('people'),
    exclude: $('exclude'),
    budget: $('budget'),
    date: $('date'),
    event: $('event'),
    note: $('note'),
  };
  const errorEl = $('santa-error');
  const sendList = $('send-list');
  const pairsEl = $('pairs');
  const showPairsBtn = $('show-pairs');
  const status = $('send-status');
  const canShare = Boolean(navigator.share);

  let draw = null; // { pairs: [[giver, recipient]], details }

  const clean = (name) => name.trim().replace(/\s+/g, ' ');
  const key = (name) => clean(name).toLowerCase();
  const people = () => fields.people.value.split('\n').map(clean).filter(Boolean);

  function details() {
    return {
      e: fields.event.value.trim(),
      b: fields.budget.value.trim(),
      d: fields.date.value,
      n: fields.note.value.trim(),
    };
  }

  function persist() {
    save(STORE_KEY, { ...Object.fromEntries(Object.entries(fields).map(([k, el]) => [k, el.value])), draw });
  }

  function makeDraw() {
    errorEl.textContent = '';
    const names = people();
    if (names.length < 3) return void (errorEl.textContent = 'Add at least 3 people.');
    if (names.length > MAX_PEOPLE) return void (errorEl.textContent = `Up to ${MAX_PEOPLE} people at a time.`);
    const index = new Map();
    for (const [i, name] of names.entries()) {
      if (index.has(key(name))) return void (errorEl.textContent = `“${name}” is on the list twice. Add a surname or initial.`);
      index.set(key(name), i);
    }

    const blocked = new Set();
    for (const line of fields.exclude.value.split('\n')) {
      const group = line.split(/[,&+]/).map(clean).filter(Boolean);
      for (const name of group) {
        if (!index.has(key(name))) return void (errorEl.textContent = `“${name}” in the exclusions isn't on the list of people.`);
      }
      for (const a of group) for (const b of group) if (a !== b) blocked.add(`${index.get(key(a))}|${index.get(key(b))}`);
    }

    const result = drawPairs(names.length, (g, r) => blocked.has(`${g}|${r}`));
    if (!result) return void (errorEl.textContent = "These exclusions don't leave a valid draw. Remove some and try again.");

    draw = { pairs: result.map((r, g) => [names[g], names[r]]), details: details(), sent: [] };
    persist();
    renderDraw();
    sfx.sparkle();
    confetti();
    award('santa');
  }

  function link(giver, recipient) {
    return revealLink(location.origin, { g: giver, r: recipient, ...draw.details });
  }

  function message(giver, url) {
    const event = draw.details.e ? ` for ${draw.details.e}` : '';
    return `🎅 Hi ${giver}! Your Secret Santa match${event} is ready. Open your private link (don't share it!): ${url}`;
  }

  function markSent(li, giver) {
    li.classList.add('sent');
    if (!draw.sent.includes(giver)) draw.sent.push(giver);
    persist();
  }

  function sendRow(giver, recipient) {
    const li = document.createElement('li');
    if (draw.sent.includes(giver)) li.classList.add('sent');
    const url = link(giver, recipient);
    const who = Object.assign(document.createElement('span'), { className: 'who', textContent: giver });
    who.append(Object.assign(document.createElement('small'), { textContent: draw.sent.includes(giver) ? 'Link sent ✓' : 'Secret link ready' }));
    const actions = Object.assign(document.createElement('span'), { className: 'btn-row' });

    const wa = Object.assign(document.createElement('a'), {
      className: 'btn btn-cyan',
      href: `https://wa.me/?text=${encodeURIComponent(message(giver, url))}`,
      target: '_blank',
      rel: 'noopener',
      textContent: 'WhatsApp',
    });
    wa.setAttribute('aria-label', `Send ${giver}'s link on WhatsApp`);
    wa.addEventListener('click', () => markSent(li, giver));

    const copy = Object.assign(document.createElement('button'), { className: 'btn', type: 'button', textContent: 'Copy link' });
    copy.setAttribute('aria-label', `Copy ${giver}'s link`);
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(message(giver, url));
        status.textContent = `${giver}'s message and link copied.`;
        markSent(li, giver);
      } catch {
        status.textContent = 'Could not copy. Use the WhatsApp button instead.';
      }
    });
    actions.append(wa, copy);

    if (canShare) {
      const share = Object.assign(document.createElement('button'), { className: 'btn', type: 'button', textContent: 'Share' });
      share.setAttribute('aria-label', `Share ${giver}'s link`);
      share.addEventListener('click', () =>
        navigator
          .share({ title: 'Your Secret Santa', text: message(giver, ''), url })
          .then(() => markSent(li, giver))
          .catch(() => {}),
      );
      actions.append(share);
    }

    li.append(who, actions);
    return li;
  }

  function renderDraw() {
    $('santa-idle').hidden = Boolean(draw);
    $('santa-done').hidden = !draw;
    pairsEl.hidden = true;
    showPairsBtn.setAttribute('aria-expanded', 'false');
    status.textContent = '';
    if (!draw) return;
    sendList.replaceChildren(...draw.pairs.map(([g, r]) => sendRow(g, r)));
    pairsEl.replaceChildren(
      ...draw.pairs.map(([g, r]) => Object.assign(document.createElement('li'), { textContent: `${g} → ${r}` })),
    );
  }

  // Three panels: the giver's name on top stays visible, the bottom flap folds up over the recipient.
  function slip(giver, recipient) {
    const d = draw.details;
    const part = (tag, text) => Object.assign(document.createElement(tag), { textContent: text });
    const panel = (className, ...children) => {
      const div = Object.assign(document.createElement('div'), { className });
      div.append(...children);
      return div;
    };
    const when = d.d ? new Date(`${d.d}T12:00`).toLocaleDateString(undefined, { dateStyle: 'medium' }) : '';
    const box = panel(
      'slip',
      panel('slip-top', part('span', `🎅 Secret Santa${d.e ? ` · ${d.e}` : ''}`), part('strong', `For ${giver}`)),
      panel(
        'slip-mid',
        part('span', "You're buying a gift for"),
        part('strong', recipient),
        part('span', [d.b && `Budget ${d.b}`, when, d.n].filter(Boolean).join(' · ')),
      ),
      panel('slip-flap', part('span', '↑ Fold this flap up to hide the name ↑'), part('small', 'winisland.in')),
    );
    return box;
  }

  $('draw').addEventListener('click', makeDraw);
  $('redraw').addEventListener('click', () => {
    if (confirm('Draw again? Everyone will need their new link.')) makeDraw();
  });

  showPairsBtn.addEventListener('click', () => {
    const open = pairsEl.hidden;
    if (open && !confirm('Show every pair? This spoils the surprise if you are playing too.')) return;
    pairsEl.hidden = !open;
    showPairsBtn.setAttribute('aria-expanded', String(open));
  });

  $('print-slips').addEventListener('click', () => {
    const pages = [];
    for (let i = 0; i < draw.pairs.length; i += 8) {
      const page = document.createElement('div');
      page.className = 'print-page slips';
      page.append(...draw.pairs.slice(i, i + 8).map(([g, r]) => slip(g, r)));
      pages.push(page);
    }
    printPages(pages);
  });

  for (const el of Object.values(fields)) {
    el.addEventListener('input', () => {
      $('people-count').textContent = `${people().length} people`;
      persist();
    });
  }

  const saved = load(STORE_KEY, null);
  if (saved && typeof saved === 'object') {
    for (const [k, el] of Object.entries(fields)) el.value = saved[k] ?? '';
    if (saved.draw?.pairs?.length) draw = { sent: [], ...saved.draw };
  }
  $('people-count').textContent = `${people().length} people`;
  renderDraw();
</script>
